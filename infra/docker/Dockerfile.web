# syntax=docker/dockerfile:1
# Optional local/preview image for the Expo static web export.
# Production serving is Cloudflare Pages.

FROM node:22-alpine AS build
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc ./
COPY scripts/configure-git-hooks.mjs scripts/
COPY apps/app/package.json apps/app/
COPY packages/shared-types/package.json packages/shared-types/

RUN pnpm install --frozen-lockfile || pnpm install

COPY apps/app/ apps/app/
COPY packages/shared-types/ packages/shared-types/

ARG EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
ARG EXPO_PUBLIC_APP_ENV=local
ENV EXPO_PUBLIC_API_BASE_URL=$EXPO_PUBLIC_API_BASE_URL
ENV EXPO_PUBLIC_APP_ENV=$EXPO_PUBLIC_APP_ENV

RUN pnpm --filter @tazakhabar/app build:web

FROM nginx:1.27-alpine AS final
COPY infra/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
