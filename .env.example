# Local development (docker-compose)

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Database=Host=postgres;Port=5432;Database=newsfeed;Username=newsfeed;Password=newsfeed_dev_password
Cors__AllowedOrigins__0=http://localhost:8081
Cors__AllowedOrigins__1=http://127.0.0.1:8081
Cors__AllowedOrigins__2=http://localhost:19006
Cors__AllowedOrigins__3=http://127.0.0.1:19006
Cors__AllowedOrigins__4=http://localhost:5173
Cors__AllowedOrigins__5=http://127.0.0.1:5173
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60
Serilog__MinimumLevel=Information
RssIngest__Secret=dev-ingest-key
Admin__Password=dev-admin-password
Admin__JwtSigningKey=dev-admin-jwt-signing-key-min-32-chars
ArticleIntelligence__ApiKey=
ArticleIntelligence__BaseUrl=https://api.anthropic.com
ArticleIntelligence__Model=claude-sonnet-4-5
Upload__RootPath=

# Expo app (web + native)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_APP_ENV=local

# Admin SPA
# VITE_API_BASE_URL=http://localhost:8080
