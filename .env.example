# Local development (docker-compose)

# API
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__Database=Host=postgres;Port=5432;Database=newsfeed;Username=newsfeed;Password=newsfeed_dev_password
Cors__AllowedOrigins__0=http://localhost:8081
Cors__AllowedOrigins__1=http://127.0.0.1:8081
Cors__AllowedOrigins__2=http://localhost:19006
Cors__AllowedOrigins__3=http://127.0.0.1:19006
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=60
Serilog__MinimumLevel=Information
RssIngest__Secret=dev-ingest-key

# Expo app (web + native)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_APP_ENV=local
