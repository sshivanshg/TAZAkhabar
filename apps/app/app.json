{
  "expo": {
    "name": "Khabro",
    "slug": "khabro",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "khabro",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.khabro.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#155EEF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.khabro.mobile",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Khabro",
      "shortName": "Khabro",
      "lang": "en",
      "themeColor": "#155EEF",
      "backgroundColor": "#F4F6FA",
      "description": "Fresh, clear local news for your city from Khabro."
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Khabro to use your location once to find the nearest city news feed."
        }
      ]
    ]
  }
}
