{
  "expo": {
    "name": "TazaKhabar",
    "slug": "tazakhabar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "tazakhabar",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.tazakhabar.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#155EEF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.tazakhabar.mobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "TazaKhabar",
      "shortName": "TazaKhabar",
      "lang": "en",
      "themeColor": "#155EEF",
      "backgroundColor": "#F4F6FA",
      "description": "Fresh, clear local news for your city from TazaKhabar."
    },
    "plugins": [
      "expo-font",
      "expo-router"
    ]
  }
}
