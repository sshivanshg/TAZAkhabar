{
  "expo": {
    "name": "NewsFeed",
    "slug": "newsfeed",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "newsfeed",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.newsfeed.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "app.newsfeed.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "NewsFeed",
      "shortName": "NewsFeed",
      "lang": "en",
      "themeColor": "#000000",
      "backgroundColor": "#ffffff",
      "description": "Local news summaries for your city."
    },
    "plugins": [
      "expo-font",
      "expo-router"
    ]
  }
}
