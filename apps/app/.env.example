# Default to the hosted API so reader UI work (and local Gradle APK builds) do
# not require the .NET API, Postgres, or Docker. For device APKs, keep this
# public URL — never point at localhost (that is the phone, not your laptop).
# Copy these two lines into apps/app/.env before `pnpm build:apk`.
EXPO_PUBLIC_API_BASE_URL=https://buildy-140j.onrender.com
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SUPPORT_EMAIL=
