{
  "name": "tazakhabar",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev:app": "pnpm --filter @tazakhabar/app start",
    "dev:web": "pnpm --filter @tazakhabar/app web",
    "build:web": "pnpm --filter @tazakhabar/app build:web",
    "build:apk": "pnpm --filter @tazakhabar/app build:apk",
    "lint:app": "pnpm --filter @tazakhabar/app lint",
    "test:app": "pnpm --filter @tazakhabar/app test",
    "generate:types": "pnpm --filter @tazakhabar/shared-types generate",
    "dev:admin": "pnpm --filter @tazakhabar/admin dev",
    "build:admin": "pnpm --filter @tazakhabar/admin build",
    "dev:api": "dotnet run --project apps/api/TazaKhabar.Api.csproj",
    "test:api": "dotnet test TazaKhabar.sln",
    "build:api": "dotnet build TazaKhabar.sln -c Release"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  }
}
