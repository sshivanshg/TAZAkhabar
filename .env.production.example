# Production — Neon Postgres + Render API + Cloudflare Pages (Expo web export)

ASPNETCORE_ENVIRONMENT=Production
DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE=false
ConnectionStrings__Database=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
Cors__AllowedOrigins__0=https://YOUR_DOMAIN
Cors__AllowedOrigins__1=https://newsfeed-admin.pages.dev
RateLimiting__PermitLimit=60
RateLimiting__WindowSeconds=60
Serilog__MinimumLevel=Warning
RssIngest__Secret=
ArticleRetention__Days=7
Admin__Password=
Admin__JwtSigningKey=
ArticleIntelligence__ApiKey=
ArticleIntelligence__BaseUrl=https://api.anthropic.com
ArticleIntelligence__Model=claude-sonnet-4-5
OpenAiRewrite__ApiKey=
OpenAiRewrite__BaseUrl=https://api.openai.com/v1
OpenAiRewrite__Model=gpt-4o-mini
Upload__RootPath=

EXPO_PUBLIC_API_BASE_URL=https://api.YOUR_DOMAIN
EXPO_PUBLIC_APP_ENV=production
VITE_API_BASE_URL=https://api.YOUR_DOMAIN
