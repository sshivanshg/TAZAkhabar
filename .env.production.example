# Production — Neon Postgres + Render API + Cloudflare Pages (Expo web export)

ASPNETCORE_ENVIRONMENT=Production
DOTNET_HOSTBUILDER__RELOADCONFIGONCHANGE=false
ConnectionStrings__Database=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
Cors__AllowedOrigins__0=https://YOUR_DOMAIN
RateLimiting__PermitLimit=60
RateLimiting__WindowSeconds=60
Serilog__MinimumLevel=Warning

EXPO_PUBLIC_API_BASE_URL=https://api.YOUR_DOMAIN
EXPO_PUBLIC_APP_ENV=production
