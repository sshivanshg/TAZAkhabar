# Staging — Neon Postgres + Railway API + Cloudflare Pages (Expo web export)

ASPNETCORE_ENVIRONMENT=Staging
ConnectionStrings__Database=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
Cors__AllowedOrigins__0=https://staging.YOUR_DOMAIN
RateLimiting__PermitLimit=60
RateLimiting__WindowSeconds=60
Serilog__MinimumLevel=Information

EXPO_PUBLIC_API_BASE_URL=https://api-staging.YOUR_DOMAIN
EXPO_PUBLIC_APP_ENV=staging
